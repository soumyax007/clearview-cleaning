# MongoDB Atlas or another MongoDB connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Resend API key (https://resend.com) — used to send owner + customer emails.
RESEND_API_KEY=re_your_api_key_here

# Email address that receives a notification for every new quote request.
OWNER_EMAIL=owner@example.com

# Optional: verified sending address in Resend. Falls back to Resend's
# shared test sender (onboarding@resend.dev) if not set — fine for testing,
# but verify your own domain in Resend before relying on this for real traffic.
EMAIL_FROM=Clearview Cleaning Co. <hello@yourdomain.com>

# Shared secret required to view submitted quotes via GET /api/quotes.
# Generate any long random string, e.g. with: openssl rand -hex 32
ADMIN_API_KEY=replace_with_a_long_random_string
